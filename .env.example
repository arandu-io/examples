# Copy to .env and fill in. Never commit .env.

APP_NAME=arandu-examples
APP_ENV=dev

# Generate with: aru key:generate
APP_KEY=

HTTP_ADDR=:8080
LOG_LEVEL=info

# SQLite is the default: a file, no server, nothing to install.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Used by pgsql and mysql only.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# A managed platform usually hands out one URL. When set, it wins over the block
# above.
DATABASE_URL=

# The tenant every login belongs to. Leave empty to use the constant in
# cmd/app/main.go, which is what the seeder writes into.
ARANDU_TENANT_ID=

# Read by the AdminSeeder only. Remove them once the user exists.
ARANDU_ADMIN_EMAIL=admin@example.test
ARANDU_ADMIN_PASSWORD=

# Enables the request Collector outside development, for requests carrying this
# value in X-Arandu-Trace.
ARANDU_TRACING_SECRET=

# Target of the "open in editor" links on the error page.
ARANDU_EDITOR=vscode
