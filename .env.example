# Copy to .env and fill in. Never commit .env.
#
# The sections below follow config/: one block per file, in the same order. A
# variable that is not read by any of those files is a variable nobody reads.

# --- config/app.go ---------------------------------------------------------
APP_NAME=Arandu Notes
APP_ENV=dev
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en

# Generate with: aru key:generate
APP_KEY=

HTTP_ADDR=:8080

# --- config/http.go --------------------------------------------------------
# The largest request body the application reads, in bytes. Empty keeps the
# default of 4 MiB, sized for forms. It is a ceiling for every route: a request
# declaring a larger body is answered 413 before the session or the CSRF check
# runs. An application that accepts bigger uploads raises it to the largest
# upload, and keeps forms tighter with LimitBodySize on their route group.
HTTP_MAX_BODY_BYTES=
# The proxies whose X-Forwarded-For is believed: comma-separated addresses or
# CIDR prefixes, such as 10.0.0.0/8,fd00::/8. Empty trusts nobody, which is right
# for a process the internet reaches directly. Behind a load balancer, list it:
# otherwise every visitor arrives from the balancer's address and shares one
# rate limit and one sign-in throttle.
TRUSTED_PROXIES=

# --- config/logging.go -----------------------------------------------------
LOG_LEVEL=info
# json or text. Text is the default in development, json everywhere else.
LOG_FORMAT=
# Drop one in N info records under load. Empty keeps all of them.
LOG_SAMPLING=

# --- config/database.go ----------------------------------------------------
# One URL, and the scheme is what says which database it is.
#
# It used to be seven variables with DATABASE_URL overriding them when set, and
# that is two ways to say where the database is -- the failure being half of one
# and half of the other, every value correct on its own. The DB_* names are
# refused now rather than ignored.
#
#     DATABASE_URL=postgres://user:password@host:5432/dbname
#     DATABASE_URL=mysql://user:password@host:3306/dbname
#     DATABASE_URL=sqlite://database/database.sqlite
#
# A password with @ / : ? or # in it is percent-encoded, like in any URL.
# Anything after ? reaches the driver: sslmode, application_name, a timezone.
#
# This is compose.yml's, so `docker compose up -d postgres` and it works.
DATABASE_URL=postgres://arandu:arandu@127.0.0.1:5432/arandu

# The pool. Tuning rather than identity -- the same for every driver, and it
# does not change when the database moves.
#
# Left out on purpose, and that is the setting: unset means the pool the
# database package applies, and writing a number here is how a project asks for
# a different one. The three below are the shape, commented out, because a
# value copied from the default is one that stops matching it silently on the
# day the default changes. Zero is refused rather than read: it means "take the
# bound off" to one reader and "give me the default" to another, and only the
# second is implemented.
#
# Seconds, not Go's duration syntax: 3600 survives a deployment template where
# 1h does not.
#DB_MAX_OPEN_CONNS=50
#DB_MAX_IDLE_CONNS=10
#DB_CONN_MAX_LIFETIME=900

# --- config/auth.go --------------------------------------------------------
# The tenant every login belongs to. `aru db:seed` prints one when it has to
# generate it. A multi-tenant application resolves it per request instead:
# the sign-in screens `ui auth` publishes take an authui.TenantResolver, in
# app/Http/Controllers/Auth.
ARANDU_TENANT_ID=

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_RESET_TTL=3600

# Read by the AdminSeeder only, to create the first administrator. Remove them
# once the user exists: there is no reason to keep a password in .env.
ARANDU_ADMIN_EMAIL=
ARANDU_ADMIN_PASSWORD=

# --- config/session.go -----------------------------------------------------
# memory or kv. Memory is right for one instance and wrong for two: behind a
# load balancer, half the requests land on the replica that never saw the login.
SESSION_DRIVER=memory
# How long a session lasts, in minutes: 720 is twelve hours. Left empty it is
# the framework's default of two hours. The cookie is written on path /, for
# the host that answered, with SameSite=Lax, and nothing here changes that:
# SESSION_PATH, SESSION_DOMAIN and SESSION_SAME_SITE stop the boot when they
# ask for anything else, and so does SESSION_TTL, the seconds this used to be.
SESSION_LIFETIME=720
# Marks the session, flash and CSRF cookies HTTPS-only. Left empty they are
# Secure unless APP_ENV=dev, and APP_ENV left unset counts as dev. Declare
# false only to serve over http outside dev -- a Secure cookie never reaches a
# browser on http, and the session disappears between requests. Behind a proxy
# that terminates TLS leave it empty: this process sees http, the browser does
# not.
SESSION_SECURE_COOKIE=
CSRF_TTL=7200

# --- config/cache.go -------------------------------------------------------
CACHE_STORE=memory
CACHE_PREFIX=
CACHE_TTL=600

# The RESP endpoint, read by the cache and by the session store. Dragonfly,
# Redis, Valkey and KeyDB all speak it. Only needed once either of them runs on
# more than one pod.
REDIS_URL=

# --- config/queue.go -------------------------------------------------------
# database keeps jobs in a table of this application's own database, which is
# what makes a job commitable by the same transaction as the row it is about.
QUEUE_CONNECTION=database
QUEUE_DEFAULT=default
QUEUE_WORKERS=4
QUEUE_RETRY_AFTER=90
QUEUE_MAX_ATTEMPTS=5

# --- config/filesystems.go -------------------------------------------------
# local, r2 or s3. R2 first: the S3 protocol without the egress bill.
FILESYSTEM_DISK=local
FILESYSTEM_ROOT=storage/app/private
FILESYSTEM_BUCKET=
FILESYSTEM_ENDPOINT=
FILESYSTEM_REGION=auto
FILESYSTEM_ACCESS_KEY_ID=
FILESYSTEM_SECRET_ACCESS_KEY=

# --- config/mail.go --------------------------------------------------------
# One URL, and the scheme is the transport.
#
#     MAIL_URL=log://                                   nothing is sent
#     MAIL_URL=smtp://user:password@smtp.example.com:587
#     MAIL_URL=smtps://user:password@smtp.example.com   implicit TLS, port 465
#     MAIL_URL=resend://re_xxxxxxxx
#     MAIL_URL=sendgrid://SG.xxxxxxxx
#     MAIL_URL=array://                                 what the tests read
#
# log:// writes the message to the output of `aru dev` instead of sending it,
# which is where the verification link and the password reset link both end up.
# A framework that sends real mail from a laptop is one that mails a customer
# during a test.
#
# For resend, the address below has to be on a domain verified in the dashboard.
# Resend answers 422 for anything else, and the reason reaches the log.
MAIL_URL=log://

# Who the application is, which does not change when the provider does.
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=

# --- config/services.go ----------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
POSTMARK_SERVER_TOKEN=

# --- observability ---------------------------------------------------------
# Enables the request Collector outside development, for requests carrying this
# value in X-Arandu-Trace. Leave empty in production unless you are tracing.
ARANDU_TRACING_SECRET=

# Target of the "open in editor" links on the error page: vscode, cursor, goland, zed.
ARANDU_EDITOR=vscode
