.env
bin/
tmp/
*.test
*.out

# `go build .` from the root drops the binary here, named after the module.
#
# It is NOT "/app". That rule was here while the entry point was ./cmd/app, and
# it silently excluded the whole app/ directory the day the tree became
# Laravel's -- every controller, model and policy, untracked and invisible.
/arandu

# Local module resolution while the framework is not published.
go.work
go.work.sum

.DS_Store
# SQLite lives here in development. The file is never committed.
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal

# The SQLite file `aru migrate` creates. It is a working copy, not the schema:
# the schema is database/migrations, and a committed database is one that
# disagrees with them by the second day.
database/*.sqlite
database/*.db
